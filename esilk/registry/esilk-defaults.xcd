<?xml version="1.0"?>
<!--
 This Source Code Form is subject to the terms of the Mozilla Public
 License, v. 2.0. If a copy of the MPL was not distributed with this
 file, You can obtain one at http://mozilla.org/MPL/2.0/.

 esilkOffice product defaults (share layer). A value stored in the user
 profile overrides them.

 Linguistic/General/UILocale=kk: Kazakh is the default user interface for a
 new profile; a language the user selects is stored in the user profile and
 overrides this default, including after an upgrade.

 No LibreOffice fundraising or community prompts (sfx2/source/view/viewfrm.cxx,
 sfx2/source/dialog/infobar.cxx, sfx2/source/dialog/backingwindow.cxx):
 * Office.UI/Infobar/Enabled/{Donate,GetInvolved,WhatsNew}=false: the infobar
   container refuses these infobars, whatever the date or version.
 * Setup/Product/LastTime{Donate,GetInvolved}Shown=4102444800 (2100-01-01
   00:00 UTC): the periodic check is never due, so the office never stores
   its own timestamps for these prompts in the profile.
 * Setup/Product/WhatsNewDialog=false: after a version upgrade the office
   takes the infobar branch (disabled above) instead of opening the What's
   New dialog. Setup/Product/WhatsNew deliberately stays true: it also drives
   the first-start Welcome dialog (interface and appearance choice) and the
   upgrade bookkeeping (ooSetupLastVersion, Misc/FirstRun, tdf#35568).
 * Office.Common/Misc/ShowDonation=false: the Start Center shows its
   Extensions button instead of Donate and never shows the donation banner.
 * Office.Common/Misc/ShowTipOfTheDay=false: the Tip of the Day dialog no
   longer opens by itself (SfxApplication::IsTipOfTheDayDue, used by sfx2 and
   sd). The upstream tip list (cui/inc/tipoftheday.hrc) asks for donations,
   invites users to join the LibreOffice community and links to
   libreoffice.org. Help > Tip of the Day still opens it on request.

 No LibreOffice community links where esilkOffice has its own identity:
 * Office.Commands/Execute/Disabled: Help > Donate, Get Involved and Send
   Feedback are hidden and cannot be dispatched (menubarmanager.cxx hides
   disabled commands). Get Help Online and User Guides stay.
 * Help/StartCenter/InfoURL (About > Website) and Menus/VolunteerURL (click on
   the Start Center brand image) open the esilkOffice website. The office
   appends the UI language code (svtools localizeWebserviceURI), so the value
   ends in /l/ and the website redirects /l/kk, /l/ru and /l/en. An empty value
   hides the About button / disables the click (esilk guards in
   cui/source/dialogs/about.cxx and sfx2/source/dialog/backingwindow.cxx).
 * Help/BuiltInHelpNotInstalledPopUp=false: F1 opens the online help directly
   instead of a popup that offers to install a LibreOffice help pack.

 Microsoft Office formats by default (owner idea F1; most users in Kazakhstan
 exchange .docx/.xlsx/.pptx):
 * Setup/Office/Factories/<module>/ooSetupFactoryDefaultFilter: a new Writer
   document is saved as Word 2007-365 (.docx), Calc as Excel 2007-365 (.xlsx),
   Impress as PowerPoint 2007-365 (.pptx). sfx2/source/doc/guisaveas.cxx
   preselects this filter in the Save As dialog of a document that has no
   format yet; a document opened from a file keeps its own format. Draw, Math,
   Base, master documents, HTML and the database forms/reports keep their
   upstream (ODF/HTML) defaults: Microsoft Office has no equivalent format for
   them. Templates are saved with ooSetupFactoryActualTemplateFilter, which is
   finalized upstream and stays ODF (.ott/.ots/.otp). Autorecovery copies use
   ooSetupFactoryActualFilter (finalized, ODF). The KZ extension shows a
   "Save format" switch that stores the user's choice in the user profile.
   The writer, calc and impress dependencies make these values load after the
   module files that define the factories (optional: a module may be absent).
 * Office.Common/Save/Document/WarnAlienFormat=false: no "Use Word/ODF format
   or keep the current format?" question on Save (guisaveas.cxx
   WarnUnacceptableFormat). A document is saved in the format it was opened
   in; Save As changes the format.

 The other LibreOffice URLs (Office.Common/Menus/*URL, Help/HelpRootURL,
 ExtensionManager/ExtensionRepositories/WebsiteLink) are deliberately not
 blanked: their callers append a query or a language code and pass the result
 to SystemShellExecute (URIS_ONLY), so an empty value turns a link into an
 error dialog instead of hiding it.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry"><dependency file="main"/><dependency file="writer" optional="true"/><dependency file="calc" optional="true"/><dependency file="impress" optional="true"/><oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office"><node oor:name="General"><prop oor:name="UILocale"><value>kk</value></prop></node></oor:component-data><oor:component-data oor:name="Infobar" oor:package="org.openoffice.Office.UI"><node oor:name="Enabled"><prop oor:name="Donate"><value>false</value></prop><prop oor:name="GetInvolved"><value>false</value></prop><prop oor:name="WhatsNew"><value>false</value></prop></node></oor:component-data><oor:component-data oor:name="Setup" oor:package="org.openoffice"><node oor:name="Product"><prop oor:name="LastTimeDonateShown"><value>4102444800</value></prop><prop oor:name="LastTimeGetInvolvedShown"><value>4102444800</value></prop><prop oor:name="WhatsNewDialog"><value>false</value></prop></node><node oor:name="Office"><node oor:name="Factories"><node oor:name="com.sun.star.text.TextDocument"><prop oor:name="ooSetupFactoryDefaultFilter"><value>MS Word 2007 XML</value></prop></node><node oor:name="com.sun.star.sheet.SpreadsheetDocument"><prop oor:name="ooSetupFactoryDefaultFilter"><value>Calc MS Excel 2007 XML</value></prop></node><node oor:name="com.sun.star.presentation.PresentationDocument"><prop oor:name="ooSetupFactoryDefaultFilter"><value>Impress MS PowerPoint 2007 XML</value></prop></node></node></node></oor:component-data><oor:component-data oor:name="Common" oor:package="org.openoffice.Office"><node oor:name="Misc"><prop oor:name="ShowDonation"><value>false</value></prop><prop oor:name="ShowTipOfTheDay"><value>false</value></prop></node><node oor:name="Save"><node oor:name="Document"><prop oor:name="WarnAlienFormat"><value>false</value></prop></node></node><node oor:name="Help"><prop oor:name="BuiltInHelpNotInstalledPopUp"><value>false</value></prop><node oor:name="StartCenter"><prop oor:name="InfoURL"><value>https://esilk.akbrd.com/l/</value></prop></node></node><node oor:name="Menus"><prop oor:name="VolunteerURL"><value>https://esilk.akbrd.com/l/</value></prop></node></oor:component-data><oor:component-data oor:name="Commands" oor:package="org.openoffice.Office"><node oor:name="Execute"><node oor:name="Disabled"><node oor:name="esilkDonation" oor:op="replace"><prop oor:name="Command"><value>Donation</value></prop></node><node oor:name="esilkGetInvolved" oor:op="replace"><prop oor:name="Command"><value>GetInvolved</value></prop></node><node oor:name="esilkSendFeedback" oor:op="replace"><prop oor:name="Command"><value>SendFeedback</value></prop></node></node></node></oor:component-data></oor:data>
