#: sdext/inc/strings.hrc:26
msgctxt "STR_OPTIMIZE_IMAGES"
msgid "Optimize 1 image to %QUALITY% JPEG quality at %RESOLUTION DPI."
msgid_plural "Optimize %IMAGES images to %QUALITY% JPEG quality at %RESOLUTION DPI."
msgstr[0] "Оптимизировать %IMAGES изображение до качества JPEG %QUALITY% при %RESOLUTION DPI."
msgstr[1] "Оптимизировать %IMAGES изображения до качества JPEG %QUALITY% при %RESOLUTION DPI."
msgstr[2] "Оптимизировать %IMAGES изображений до качества JPEG %QUALITY% при %RESOLUTION DPI."
