#: sw/uiconfig/swriter/ui/tabletextflowpage.ui:339
msgctxt "tabletextflowpage|extended_tip|headline"
msgid "Repeats the table header on a new page when the table spans more than one page."
msgstr "Повторяет заголовок таблицы на новой странице, если таблица занимает больше одной страницы."

