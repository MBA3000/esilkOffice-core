msgstr "Привязывает к границам символов."

#. Pyktu
#: sw/uiconfig/swriter/ui/textgridpage.ui:411
msgctxt "textgridpage|extended_tip|spinMF_CHARWIDTH"
msgid "Enter the character width for the grid with lines and characters."
msgstr "Введите ширину символов для сетки строк и символов."

#. Gkpad
#: sw/uiconfig/swriter/ui/textgridpage.ui:500
msgctxt "textgridpage|extended_tip|checkCB_DISPLAY"
