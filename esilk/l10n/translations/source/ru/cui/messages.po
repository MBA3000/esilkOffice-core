#. f4o3L
#: cui/uiconfig/ui/dimensionlinestabpage.ui:291
msgctxt "dimensionlinestabpage|TSB_AUTO_DECIMAL_PLACES"
msgid "_Automatic"
msgstr "_Автоматически"

#. Tb5go
#: cui/uiconfig/ui/dimensionlinestabpage.ui:301
msgctxt "dimensionlinestabpage|extended_tip|TSB_AUTO_DECIMAL_PLACES"
msgid "Automatically adapts the number of displayed decimal places based on the precision of the measured value."
msgstr "Автоматически подбирает количество отображаемых знаков после запятой в зависимости от точности измеренного значения."

#. 7AAvr
#: cui/uiconfig/ui/optlanguagespage.ui:179
msgctxt "extended_tip|asianlanguage"
msgid "Specifies the Asian language used for the spellcheck function."
msgstr "Указывает восточноазиатский язык, используемый для проверки орфографии."

#. H4F36
#: cui/uiconfig/ui/optlanguagespage.ui:361
msgctxt "optlanguagespage|useinputlanguage"
msgid "Apply s_ystem input language to new text"
msgstr "Применять _язык ввода системы к новому тексту"

#. VetSF
#: cui/uiconfig/ui/optlanguagespage.ui:369
msgctxt "extended_tip|useinputlanguage"
msgid "Indicates whether the system input language is applied to newly typed text; when disabled, the document or paragraph language is used instead."
msgstr "Указывает, применяется ли язык ввода системы к вновь набираемому тексту; если параметр отключён, используется язык документа или абзаца."

#. ZD7Mj
#: cui/uiconfig/ui/optuserpage.ui:422
msgctxt "extended tip | position"
msgid "Type your position in the organization in this field."
msgstr "Введите в этом поле свою должность в организации."

#. NFKSM
#: cui/uiconfig/ui/optuserpage.ui:455
msgctxt "optuserpage|companyft"
msgid "Or_ganization:"
msgstr "Ор_ганизация:"

#. 3tgEW
#: cui/uiconfig/ui/optuserpage.ui:481
msgctxt "extended tip | company"
msgid "Type the name of your organization in this field."
msgstr "Введите в этом поле название своей организации."

#. Qnsa8
#: cui/uiconfig/ui/optviewpage.ui:199
msgctxt "optviewpage|forceskiagpu"
msgid "Force Skia hardware acceleration"
msgstr "Принудительное аппаратное ускорение Skia"

#. APxH2
#: cui/uiconfig/ui/optviewpage.ui:203
msgctxt "optviewpage|forceskia|tooltip_text"
msgid "Requires restart. Enabling this will enable the use of Skia hardware acceleration."
msgstr "Требуется перезапуск. При включении Skia будет использовать аппаратное ускорение."

#. 3jsyE
#: cui/uiconfig/ui/optviewpage.ui:209
msgctxt "optviewpage|extended_tips|forceskiagpu"
msgid "Enables Skia's use of the computer graphics device. This still uses Skia software but with hardware acceleration enabled."
msgstr "Разрешает Skia использовать графическое устройство компьютера. По-прежнему используется программная часть Skia, но с включённым аппаратным ускорением."

#. maaHp
#: cui/uiconfig/ui/paragalignpage.ui:676
msgctxt "paralignpage|checkParaComposer"
msgid "Paragraph Composer"
msgstr "Компоновщик абзацев"

#. fkGhh
#: cui/uiconfig/ui/paragalignpage.ui:685
msgctxt "textflowpage|extended_tip|checkParaComposer"
msgid "Select this check box, if you want to get evenly spaced words in the consecutive lines."
msgstr "Установите этот флажок, чтобы получить равномерные интервалы между словами в соседних строках."

#. 4zsBp
#: cui/uiconfig/ui/positionpage.ui:521
msgctxt "positionpage|opticalsizing"
msgid "Enable optical font sizing based on font's point size for fonts that support it"
msgstr "Включить оптические размеры шрифта на основе его кегля для шрифтов, которые это поддерживают"

