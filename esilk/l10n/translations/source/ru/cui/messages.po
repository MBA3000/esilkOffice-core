#. yevwi
#: cui/inc/tipoftheday.hrc:57
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To start temporarily with a fresh user profile, or to restore a non-working %PRODUCTNAME, use Help ▸ Restart in Troubleshoot Mode."
msgstr "Чтобы временно запустить программу с чистым профилем пользователя или восстановить неработающий %PRODUCTNAME, выберите «Справка ▸ Перезапустить в безопасном режиме»."

#. M2LZZ
#: cui/inc/tipoftheday.hrc:66
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Select a different icon set from Tools ▸ Options ▸ %PRODUCTNAME ▸ Appearance ▸ Icons."
msgstr "Выберите другой набор значков в «Сервис ▸ Параметры ▸ %PRODUCTNAME ▸ Внешний вид ▸ Значки»."

#. xGWYj
#: cui/inc/tipoftheday.hrc:87
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%MOD1+%SHIFT+F9 recalculates all formulas in all spreadsheets."
msgstr "%MOD1+%SHIFT+F9 пересчитывает все формулы во всех электронных таблицах."

#. Pj8Lw
#: cui/inc/tipoftheday.hrc:91
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To repeat a table header when a table spans over a page, use Table ▸ Table Properties ▸ Text Flow ▸ Repeat header."
msgstr "Чтобы повторять заголовок таблицы, когда таблица переходит на следующую страницу, используйте «Таблица ▸ Свойства таблицы ▸ Положение на странице ▸ Повторять заголовок»."

#. Fr2CP
#: cui/inc/tipoftheday.hrc:95
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to insert the date in a spreadsheet cell? Type %MOD1+; or %SHIFT+%MOD1+; to insert the time."
msgstr "Нужно вставить дату в ячейку электронной таблицы? Нажмите %MOD1+; или %SHIFT+%MOD1+;, чтобы вставить время."

#. oaYQX
#: cui/inc/tipoftheday.hrc:98
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use %SHIFT+Space to select the current row and %MOD3+Space to select the current column."
msgstr "Используйте %SHIFT+Space, чтобы выделить текущую строку, и %MOD3+Space, чтобы выделить текущий столбец."

#. 9Knz6
#: cui/inc/tipoftheday.hrc:121
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use %MOD1+%MOD2+%SHIFT+V to paste the contents of the clipboard as unformatted text."
msgstr "Используйте %MOD1+%MOD2+%SHIFT+V, чтобы вставить содержимое буфера обмена как неформатированный текст."

#. awjmS
#: cui/inc/tipoftheday.hrc:141
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%SHIFT+%MOD1+Del deletes from cursor to the end of the current sentence."
msgstr "%SHIFT+%MOD1+Del удаляет текст от курсора до конца текущего предложения."

#. BGkF4
#: cui/inc/tipoftheday.hrc:177
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Trace cells used in a formula, precedents (%SHIFT+F9) or dependents (%SHIFT+F5) (or use Tools ▸ Detective). For each hit you go one more step in the chain."
msgstr "Отслеживайте ячейки, используемые в формуле: влияющие (%SHIFT+F9) или зависимые (%SHIFT+F5) (или используйте «Сервис ▸ Зависимости»). Каждое нажатие продвигает на один шаг дальше по цепочке."

#. DB8YT
#: cui/inc/tipoftheday.hrc:183
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Enable massive parallel calculations of formula cells via Tools ▸ Options ▸ %PRODUCTNAME Calc ▸ Calculate ▸ CPU Threading Settings."
msgstr "Включите массовые параллельные вычисления ячеек с формулами в «Сервис ▸ Параметры ▸ %PRODUCTNAME Calc ▸ Вычисления ▸ Параметры потоков ЦП»."

#. UF2oA
#: cui/inc/tipoftheday.hrc:210
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Edit ▸ Find and Replace lets you insert special characters directly: right click in input fields or press %SHIFT+%MOD1+S."
msgstr "«Правка ▸ Найти и заменить» позволяет вставлять специальные символы напрямую: щёлкните правой кнопкой мыши в поле ввода или нажмите %SHIFT+%MOD1+S."

#. BEB8W
#: cui/inc/tipoftheday.hrc:227
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Create a backup of your document in Writer by selecting File ▸ Save a Copy while continuing to work on the original."
msgstr "Создайте резервную копию документа в Writer командой «Файл ▸ Сохранить копию» и продолжайте работать с оригиналом."

#. RCRLi
#: cui/inc/tipoftheday.hrc:239
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Having trouble pasting text from PDF files or webpages into documents? Try to paste as unformatted text (%MOD1+%MOD2+%SHIFT+V)."
msgstr "Не получается вставить в документ текст из PDF-файлов или веб-страниц? Попробуйте вставить его как неформатированный текст (%MOD1+%MOD2+%SHIFT+V)."

#. ycpXD
#. local help missing
#: cui/inc/tipoftheday.hrc:265
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to know if a cell is referred in formulas of other cells? Tools ▸ Detective ▸ Trace Dependents (%SHIFT+F5)."
msgstr "Хотите узнать, ссылаются ли на ячейку формулы других ячеек? «Сервис ▸ Зависимости ▸ Зависимые ячейки» (%SHIFT+F5)."

#. 4DJJR
#: cui/inc/tipoftheday.hrc:276
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Press %SHIFT+F1 to see any available extended tooltips in dialog boxes, when \"Extended tips\" is not enabled in Tools ▸ Options ▸ %PRODUCTNAME ▸ General."
msgstr "Нажмите %SHIFT+F1, чтобы увидеть доступные подробные всплывающие подсказки в диалоговых окнах, если параметр \"Подробные всплывающие подсказки\" не включён в «Сервис ▸ Параметры ▸ %PRODUCTNAME ▸ Общие»."

#. 3KpVf
#: cui/inc/tipoftheday.hrc:279
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Can’t find a command in the menus? Try %SHIFT+ESC."
msgstr "Не можете найти команду в меню? Попробуйте %SHIFT+ESC."

