/*
 * esilk: the Apps and Features links point to the esilkOffice website, in the
 * language of the installer (kk and ru entries in esilk/l10n). An undefined
 * template gives an empty value, and property.pm then drops the row.
 */

[OOO_ARPCONTACTTEMPLATE]
en-US = "esilk"

[OOO_ARPHELPLINKTEMPLATE]
en-US = "https://esilk.akbrd.com/en/"

[OOO_ARPURLINFOABOUTTEMPLATE]
en-US = "https://esilk.akbrd.com/en/"

[OOO_ARPURLUPDATEINFOTEMPLATE]
en-US = "https://esilk.akbrd.com/en/"

/*
 * esilk: texts of the installer refusals (scp2/source/ooo/windowscustomaction_ooo.scp,
 * Type 19 actions show [EsilkMsg...]). en-US, used on every Windows that is not kk or ru,
 * carries Kazakh, Russian and English; the kk and ru overlays in esilk/l10n give one language.
 */

[OOO_ESILK_MSG_LOCATION_REQUIRED]
en-US = "esilkOffice-тің бұл жинағын тек компьютердің барлық пайдаланушылары үшін, Program Files ішіндегі әдепкі esilkOffice қалтасына орнатуға болады.  /  Эту сборку esilkOffice можно установить только для всех пользователей компьютера, в папку esilkOffice по умолчанию в Program Files.  /  This esilkOffice build requires a machine-wide installation in the default esilkOffice directory under Program Files."

[OOO_ESILK_MSG_LIBREOFFICE_CONFLICT]
en-US = "Бұл компьютерде LibreOffice орнатылған кезде esilkOffice орнату мүмкін емес. Алдымен LibreOffice бағдарламасын жойып, содан кейін осы орнату бағдарламасын қайта іске қосыңыз.  /  esilkOffice нельзя установить, пока на этом компьютере установлен LibreOffice. Сначала удалите LibreOffice, затем снова запустите эту программу установки.  /  esilkOffice cannot be installed while LibreOffice is installed on this computer. Uninstall LibreOffice first, then run this installer again."

[OOO_ESILK_MSG_ROLLBACK_REQUIRED]
en-US = "esilkOffice кірістірілген кеңейтімін орнату үшін Windows Installer-дің кері қайтару (rollback) мүмкіндігі қажет. Бағдарламаны орнату немесе қалпына келтіру алдында оны қосыңыз.  /  Для установки встроенного расширения esilkOffice нужен откат (rollback) установщика Windows. Включите его перед установкой или восстановлением программы.  /  esilkOffice bundled extension installation requires Windows Installer rollback. Enable rollback before installing or repairing this product."

[OOO_STR_NEW_DISPLAY_NAME]
en-US = "~New"

[OOO_STR_EDIT]
en-US = "~Edit"

[OOO_STR_MS_WORD_DOCUMENT]
en-US = "Microsoft Word Document"

[OOO_STR_MS_WORD_TEMPLATE]
en-US = "Microsoft Word Template"

[OOO_STR_MS_EXCEL_WORKSHEET]
en-US = "Microsoft Excel Worksheet"

[OOO_STR_MS_EXCEL_TEMPLATE]
en-US = "Microsoft Excel Template"

[OOO_STR_MS_POWERPOINT_PRESENTATION]
en-US = "Microsoft PowerPoint Presentation"

[OOO_STR_MS_POWERPOINT_TEMPLATE]
en-US = "Microsoft PowerPoint Template"

[OOO_STR_MS_POWERPOINT_SHOW]
en-US = "Microsoft PowerPoint Show"

[OOO_STR_INSTALLATION_WIZARD]
en-US = "Installation Wizard"
